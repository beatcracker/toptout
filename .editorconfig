root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
indent_size = 4

[data/*.json]
insert_final_newline = false

[schema/*.json]
indent_size = 4
insert_final_newline = false

[.vscode/*.json]
indent_size = 4
insert_final_newline = false

[LICENSE]
indent_style = unset
indent_size = unset

[{.git,.mise,.packages,.wip}/**]
ignore = true
